# Copy this file to `.env` and fill in your values. `.env` is git-ignored.

# Contact email sent as `User-Agent: Papaver/<version> (mailto:...)`.
# Crossref and OpenAlex route requests that carry it to their faster "polite pool".
PAPAVER_CONTACT_EMAIL=

# Optional Semantic Scholar API key (raises the shared rate limit).
PAPAVER_S2_API_KEY=

# Local cache database (SQLAlchemy async URL).
PAPAVER_DB_URL=sqlite+aiosqlite:///./papaver_cache.db
