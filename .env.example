# Copy this file to `.env` and fill in your values. `.env` is git-ignored.
# Real environment variables take precedence over values in `.env`.

# Contact email sent as `User-Agent: Papaver/<version> (mailto:...)`.
# Crossref and OpenAlex route requests that carry it to their faster "polite pool".
PAPAVER_CONTACT_EMAIL=

# Optional Semantic Scholar API key. Without it, requests go to a shared public
# pool that frequently answers HTTP 429 (Papaver retries with backoff).
PAPAVER_S2_API_KEY=

# Local cache database (SQLAlchemy async URL).
PAPAVER_DB_URL=sqlite+aiosqlite:///./papaver_cache.db

# --- Optional tuning (defaults shown) ---------------------------------------
# PAPAVER_CACHE_TTL_HOURS=24        # 0 = never serve from cache
# PAPAVER_S2_MAX_CITATIONS=1000     # citing papers scanned per audit, max 9999
# PAPAVER_HTTP_TIMEOUT=15           # seconds per request
# PAPAVER_MAX_RETRIES=2             # Crossref / OpenAlex
# PAPAVER_S2_MAX_RETRIES=4          # Semantic Scholar (429s are common)
# PAPAVER_S2_MIN_INTERVAL=1.0       # seconds between Semantic Scholar requests
